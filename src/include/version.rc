/* The version resource of each binary. Its .rc defines first:
   VER_TYPE (VFT_APP or VFT_DLL), VER_DESCRIPTION, VER_NAME, VER_FILE. */
#include <ver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     2026, 11, 6, 0
PRODUCTVERSION  2026, 11, 6, 0
FILEFLAGSMASK   0
FILEFLAGS       0
FILEOS          VOS_DOS_WINDOWS16
FILETYPE        VER_TYPE
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "FileDescription", VER_DESCRIPTION
            VALUE "FileVersion",     "v20261106\0"
            VALUE "InternalName",    VER_NAME
            VALUE "OriginalFilename",VER_FILE
            VALUE "ProductName",     "Snowball\0"
            VALUE "ProductVersion",  "v20261106\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1252
    END
END
