#include <windows.h>
#include "resource.h"

/* Snowball's own icon; Windows 98's icons, cursors and bitmaps are W98ART.DLL's */
IDI_SNOWBALL    ICON "MAINICON.ICO"

IDD_RUN DIALOG 0, 0, 236, 82
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Run"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDI_SNOWBALL, IDC_DLGICON, 7, 7, 20, 20
    LTEXT           "Type the name of a program, folder, or document, and Windows will open it for you.", -1, 36, 7, 193, 18
    LTEXT           "&Open:", -1, 7, 37, 24, 8
    COMBOBOX        IDC_COMMAND, 36, 35, 193, 80, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 69, 61, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 124, 61, 50, 14
    PUSHBUTTON      "&Browse...", IDC_BROWSE, 179, 61, 50, 14
END

IDD_SHUTDOWN DIALOG 0, 0, 220, 96
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Shut Down Windows"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDI_SNOWBALL, IDC_DLGICON, 9, 9, 20, 20
    LTEXT           "What do you want the computer to do?", -1, 42, 9, 170, 8
    CONTROL         "&Shut down", IDC_SHUTDOWN, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 42, 24, 160, 10
    CONTROL         "&Restart Windows", IDC_RESTART, "Button", BS_AUTORADIOBUTTON, 42, 37, 160, 10
    CONTROL         "&Exit to MS-DOS", IDC_TODOS, "Button", BS_AUTORADIOBUTTON, 42, 50, 160, 10
    DEFPUSHBUTTON   "OK", IDOK, 107, 74, 50, 14, WS_GROUP
    PUSHBUTTON      "Cancel", IDCANCEL, 162, 74, 50, 14
END

/* The banner (IDC_ABOUT_BANNER's place) and the line above the memory are painted by aboutdialog.c */
IDD_ABOUT DIALOG 0, 0, 250, 182
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Snowball"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "", IDC_ABOUT_BANNER, 0, 0, 250, 36
    LTEXT           "", IDC_VERSION, 12, 44, 226, 18, SS_NOPREFIX
    LTEXT           "A Windows 98 style shell for Windows 3.1 and 3.11: a reimplementation of Calmira, reworked from scratch in C.", -1, 12, 66, 226, 18
    LTEXT           "Copyright (C) 2026 iFocsy", -1, 12, 90, 226, 8
    LTEXT           "github.com/iFocsy/snowball-shell", IDC_ABOUT_LINK, 12, 100, 226, 8
    LTEXT           "Inspired by Calmira. Icon from Calmira (GPL). Free software under the GNU GPL 3.", -1, 12, 114, 226, 16
    LTEXT           "", IDC_INFO, 12, 140, 160, 18
    DEFPUSHBUTTON   "OK", IDOK, 188, 160, 50, 14
END

/* Everything but Cancel is painted by progress.c (layout in ProgressProc) */
IDD_PROGRESS DIALOG 0, 0, 260, 95
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 8, "MS Sans Serif"
BEGIN
    PUSHBUTTON      "Cancel", IDCANCEL, 203, 74, 50, 14
END

IDD_REPLACE DIALOG 0, 0, 268, 124
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Confirm File Replace"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDI_SNOWBALL, IDC_DLGICON, 9, 9, 20, 20
    LTEXT           "", IDC_TEXT, 40, 9, 220, 16, SS_NOPREFIX
    LTEXT           "Would you like to replace the existing file", -1, 40, 28, 220, 8
    ICON            IDI_SNOWBALL, IDC_OLDICON, 50, 40, 20, 20
    LTEXT           "", IDC_OLDINFO, 80, 42, 180, 16
    LTEXT           "with this one?", -1, 40, 64, 220, 8
    ICON            IDI_SNOWBALL, IDC_NEWICON, 50, 76, 20, 20
    LTEXT           "", IDC_NEWINFO, 80, 78, 180, 16
    DEFPUSHBUTTON   "&Yes", IDYES, 47, 103, 50, 14
    PUSHBUTTON      "Yes to &All", IDC_YESALL, 101, 103, 50, 14
    PUSHBUTTON      "&No", IDNO, 155, 103, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 209, 103, 50, 14
END

/* Property sheets: the tabs first (lowest in the z-order), then the pages
   at the same place, shown by properties.c by id range, then the buttons. */
#define SHEET_TOP \
    CONTROL "", IDC_TABS, "SbTabs", WS_CHILD | WS_VISIBLE | WS_TABSTOP | WS_CLIPSIBLINGS, 6, 6, 215, 220
#define SHEET_BUTTONS \
    DEFPUSHBUTTON   "OK", IDOK, 63, 231, 50, 14 \
    PUSHBUTTON      "Cancel", IDCANCEL, 117, 231, 50, 14 \
    PUSHBUTTON      "&Apply", IDC_APPLY, 171, 231, 50, 14
#define SEPARATOR(id, y) CONTROL "", id, "Static", WS_CHILD, 14, y, 196, 2

IDD_PROPFILE DIALOG 0, 0, 227, 250
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Properties"
FONT 8, "MS Sans Serif"
BEGIN
    SHEET_TOP
    ICON            IDI_SNOWBALL, IDC_PROPS_ICON, 14, 28, 20, 20
    EDITTEXT        IDC_PROPS_NAME, 52, 31, 158, 12, ES_AUTOHSCROLL
    SEPARATOR(IDC_PROPS_SEP, 55)
    LTEXT           "Type:", IDC_PROPS_LABEL, 14, 63, 54, 8
    LTEXT           "", IDC_PROPS_TYPE, 70, 63, 140, 8, SS_NOPREFIX
    LTEXT           "Location:", IDC_PROPS_LABEL, 14, 76, 54, 8
    LTEXT           "", IDC_PROPS_LOCATION, 70, 76, 140, 8, SS_NOPREFIX
    LTEXT           "Size:", IDC_PROPS_LABEL, 14, 89, 54, 8
    LTEXT           "", IDC_PROPS_SIZE, 70, 89, 140, 8
    LTEXT           "Contains:", IDC_PROPS_CONTAINSL, 14, 102, 54, 8
    LTEXT           "", IDC_PROPS_CONTAINS, 70, 102, 140, 8
    SEPARATOR(IDC_PROPS_SEP, 116)
    LTEXT           "MS-DOS name:", IDC_PROPS_DATESL, 14, 124, 54, 8
    LTEXT           "", IDC_PROPS_DOSNAME, 70, 124, 140, 8, SS_NOPREFIX
    LTEXT           "Created:", IDC_PROPS_DATESL, 14, 137, 54, 8
    LTEXT           "", IDC_PROPS_CREATED, 70, 137, 140, 8
    LTEXT           "Modified:", IDC_PROPS_DATESL, 14, 150, 54, 8
    LTEXT           "", IDC_PROPS_MODIFIED, 70, 150, 140, 8
    LTEXT           "Accessed:", IDC_PROPS_DATESL, 14, 163, 54, 8
    LTEXT           "", IDC_PROPS_ACCESSED, 70, 163, 140, 8
    SEPARATOR(IDC_PROPS_SEP, 177)
    LTEXT           "Attributes:", IDC_PROPS_LABEL, 14, 186, 54, 8
    CONTROL         "&Read-only", IDC_PROPS_READONLY, "Button", BS_AUTO3STATE | WS_TABSTOP, 70, 185, 60, 10
    CONTROL         "H&idden", IDC_PROPS_HIDDEN, "Button", BS_AUTO3STATE | WS_TABSTOP, 70, 198, 60, 10
    CONTROL         "&Archive", IDC_PROPS_ARCHIVE, "Button", BS_AUTO3STATE | WS_TABSTOP, 140, 185, 60, 10
    CONTROL         "&System", IDC_PROPS_SYSTEM, "Button", BS_AUTO3STATE | WS_TABSTOP, 140, 198, 60, 10
    ICON            IDI_SNOWBALL, IDC_SHORTCUT_ICON, 14, 28, 20, 20
    LTEXT           "", IDC_SHORTCUT_NAME, 52, 33, 158, 8, SS_NOPREFIX
    SEPARATOR(IDC_SHORTCUT_SEP, 55)
    LTEXT           "Target type:", IDC_SHORTCUT_LABEL, 14, 63, 54, 8
    LTEXT           "", IDC_SHORTCUT_TYPE, 70, 63, 140, 8, SS_NOPREFIX
    LTEXT           "Target location:", IDC_SHORTCUT_LABEL, 14, 76, 54, 8
    LTEXT           "", IDC_SHORTCUT_LOCATION, 70, 76, 140, 8, SS_NOPREFIX
    LTEXT           "&Target:", IDC_SHORTCUT_LABEL, 14, 91, 54, 8
    EDITTEXT        IDC_SHORTCUT_TARGET, 70, 89, 140, 12, ES_AUTOHSCROLL
    SEPARATOR(IDC_SHORTCUT_SEP, 110)
    LTEXT           "&Start in:", IDC_SHORTCUT_LABEL, 14, 120, 54, 8
    EDITTEXT        IDC_SHORTCUT_STARTIN, 70, 118, 140, 12, ES_AUTOHSCROLL
    LTEXT           "Shortcut &key:", IDC_SHORTCUT_LABEL, 14, 138, 54, 8
    EDITTEXT        IDC_SHORTCUT_KEY, 70, 136, 140, 12, ES_AUTOHSCROLL
    LTEXT           "&Run:", IDC_SHORTCUT_LABEL, 14, 156, 54, 8
    COMBOBOX        IDC_SHORTCUT_RUN, 70, 154, 140, 50, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Find Target...", IDC_SHORTCUT_FIND, 70, 180, 68, 14
    PUSHBUTTON      "&Change Icon...", IDC_SHORTCUT_ICONBTN, 142, 180, 68, 14
    LTEXT           "File version:", IDC_VERSION_FILEL, 14, 30, 60, 8
    LTEXT           "", IDC_VERSION_FILE, 76, 30, 134, 8, SS_NOPREFIX
    LTEXT           "Description:", IDC_VERSION_DESCL, 14, 44, 60, 8
    LTEXT           "", IDC_VERSION_DESC, 76, 44, 134, 8, SS_NOPREFIX
    LTEXT           "Copyright:", IDC_VERSION_COPYL, 14, 58, 60, 8
    LTEXT           "", IDC_VERSION_COPY, 76, 58, 134, 16, SS_NOPREFIX
    GROUPBOX        "Other version information", IDC_VERSION_GROUP, 14, 80, 199, 136
    LTEXT           "&Item name:", IDC_VERSION_ITEMSL, 22, 94, 84, 8
    LISTBOX         IDC_VERSION_ITEMS, 22, 104, 84, 104, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    LTEXT           "&Value:", IDC_VERSION_VALUEL, 112, 94, 93, 8
    EDITTEXT        IDC_VERSION_VALUE, 112, 104, 93, 104, ES_MULTILINE | ES_READONLY | WS_VSCROLL
    GROUPBOX        "Folder icon", IDC_CUSTOM_ICONGROUP, 14, 30, 199, 72
    LTEXT           "The icon this folder shows in its windows, on the desktop and in Explorer.", IDC_CUSTOM_ICONTEXT, 22, 43, 183, 16
    ICON            IDI_SNOWBALL, IDC_CUSTOM_ICON, 22, 70, 20, 20
    PUSHBUTTON      "&Change Icon...", IDC_CUSTOM_CHANGE, 60, 74, 68, 14
    PUSHBUTTON      "&Restore Default", IDC_CUSTOM_DEFAULT, 134, 74, 68, 14
    GROUPBOX        "Infotip", IDC_CUSTOM_TIPGROUP, 14, 110, 199, 76
    LTEXT           "&Text shown when the mouse rests on this folder:", IDC_CUSTOM_TIPL, 22, 123, 183, 8
    EDITTEXT        IDC_CUSTOM_TIP, 22, 135, 183, 42, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
    SHEET_BUTTONS
END

IDD_PROPDRIVE DIALOG 0, 0, 227, 250
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Properties"
FONT 8, "MS Sans Serif"
BEGIN
    SHEET_TOP
    ICON            IDI_SNOWBALL, IDC_PROPS_ICON, 14, 28, 20, 20
    LTEXT           "&Label:", IDC_PROPS_LABEL, 52, 33, 30, 8
    EDITTEXT        IDC_DRIVE_LABEL, 84, 31, 126, 12, ES_AUTOHSCROLL | ES_UPPERCASE
    SEPARATOR(IDC_PROPS_SEP, 55)
    LTEXT           "Type:", IDC_PROPS_LABEL, 14, 63, 54, 8
    LTEXT           "", IDC_PROPS_TYPE, 70, 63, 140, 8
    LTEXT           "File system:", IDC_PROPS_LABEL, 14, 76, 54, 8
    LTEXT           "", IDC_DRIVE_FS, 70, 76, 140, 8
    SEPARATOR(IDC_PROPS_SEP, 90)
    CONTROL         "", IDC_DRIVE_USEDBOX, "Static", WS_CHILD, 14, 98, 8, 8
    LTEXT           "Used space:", IDC_PROPS_LABEL, 26, 98, 50, 8
    RTEXT           "", IDC_DRIVE_USED, 76, 98, 84, 8
    RTEXT           "", IDC_DRIVE_USEDS, 164, 98, 46, 8
    CONTROL         "", IDC_DRIVE_FREEBOX, "Static", WS_CHILD, 14, 111, 8, 8
    LTEXT           "Free space:", IDC_PROPS_LABEL, 26, 111, 50, 8
    RTEXT           "", IDC_DRIVE_FREE, 76, 111, 84, 8
    RTEXT           "", IDC_DRIVE_FREES, 164, 111, 46, 8
    SEPARATOR(IDC_PROPS_SEP, 125)
    LTEXT           "Capacity:", IDC_PROPS_LABEL, 26, 133, 50, 8
    RTEXT           "", IDC_DRIVE_CAP, 76, 133, 84, 8
    RTEXT           "", IDC_DRIVE_CAPS, 164, 133, 46, 8
    CONTROL         "", IDC_DRIVE_PIE, "Static", WS_CHILD, 62, 150, 100, 50
    PUSHBUTTON      "Disk Cl&eanup...", IDC_DRIVE_CLEANUP, 152, 200, 62, 14
    CTEXT           "", IDC_DRIVE_DRIVE, 72, 206, 80, 8
    SHEET_BUTTONS
END

