FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Ca&pacity:", -1, 7, 7, 100, 8
    COMBOBOX        IDC_FORMAT_CAPACITY, 7, 18, 156, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "Format type", -1, 7, 38, 156, 52
    CONTROL         "&Quick (erase)", IDC_FORMAT_QUICK, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 15, 51, 140, 10
    CONTROL         "&Full", IDC_FORMAT_FULL, "Button", BS_AUTORADIOBUTTON, 15, 63, 140, 10
    CONTROL         "Copy system files &only", IDC_FORMAT_SYSONLY, "Button", BS_AUTORADIOBUTTON, 15, 75, 140, 10
    GROUPBOX        "Other options", -1, 7, 96, 156, 58, WS_GROUP
    LTEXT           "&Label:", -1, 15, 110, 28, 8
    EDITTEXT        IDC_FORMAT_LABEL, 45, 108, 110, 12, ES_UPPERCASE | ES_AUTOHSCROLL
    CONTROL         "&No label", IDC_FORMAT_NOLABEL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 125, 140, 10
    CONTROL         "Cop&y system files", IDC_FORMAT_SYS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 139, 140, 10
    DEFPUSHBUTTON   "&Start", IDOK, 173, 7, 50, 14
    PUSHBUTTON      "&Close", IDCANCEL, 173, 25, 50, 14
END

IDD_CLEANUP DIALOG 0, 0, 230, 214
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Disk Cleanup"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "D&rive:", -1, 7, 9, 26, 8
    COMBOBOX        IDC_CLEANUP_DRIVE, 36, 7, 60, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    ICON            IDI_SNOWBALL, IDC_CLEANUP_ICON, 7, 26, 20, 20
    LTEXT           "", IDC_CLEANUP_TEXT, 36, 28, 187, 16
    LTEXT           "&Files to delete:", -1, 7, 50, 100, 8
    LISTBOX         IDC_CLEANUP_LIST, 7, 60, 216, 58, LBS_OWNERDRAWFIXED | LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    LTEXT           "", IDC_CLEANUP_TOTAL, 7, 122, 216, 8
    GROUPBOX        "Description", -1, 7, 134, 216, 54
    LTEXT           "", IDC_CLEANUP_ABOUT, 14, 146, 202, 38
    DEFPUSHBUTTON   "OK", IDOK, 119, 194, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 173, 194, 50, 14
END

IDD_LOWDISK DIALOG 0, 0, 230, 74
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Low Disk Space"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDI_SNOWBALL, IDC_LOWDISK_ICON, 7, 8, 20, 20
    LTEXT           "", IDC_LOWDISK_TEXT, 36, 8, 187, 40
    DEFPUSHBUTTON   "&Disk Cleanup", IDOK, 103, 54, 64, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 173, 54, 50, 14
END

IDD_DATETIME DIALOG 0, 0, 252, 188
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Date/Time Properties"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL         "", IDC_TABS, "SbTabs", WS_CHILD | WS_VISIBLE | WS_CLIPSIBLINGS | WS_TABSTOP, 6, 6, 240, 156
    GROUPBOX        "&Date", -1, 14, 26, 124, 128
    COMBOBOX        IDC_DT_MONTH, 22, 40, 62, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_DT_YEAR, 88, 40, 42, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "", IDC_DT_CALENDAR, "Static", SS_LEFT, 22, 58, 108, 88
    GROUPBOX        "&Time", -1, 144, 26, 94, 128
    CONTROL         "", IDC_DT_CLOCK, "Static", SS_LEFT, 156, 40, 70, 80
    EDITTEXT        IDC_DT_TIME, 160, 128, 62, 12, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 86, 168, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 141, 168, 50, 14
    PUSHBUTTON      "&Apply", IDC_APPLY, 196, 168, 50, 14
END
