/* The results view (below y = 104) and the status bar are made by find.c */
IDD_FIND DIALOG 0, 0, 300, 220
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX
CAPTION "Find: All Files"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL         "", IDC_TABS, "SbTabs", WS_CHILD | WS_VISIBLE | WS_CLIPSIBLINGS | WS_TABSTOP, 6, 6, 222, 92
    LTEXT           "&Named:", -1, 14, 28, 54, 8
    EDITTEXT        IDC_FIND_NAMED, 70, 26, 150, 12, ES_AUTOHSCROLL
    LTEXT           "&Containing text:", -1, 14, 45, 56, 8
    EDITTEXT        IDC_FIND_TEXT, 70, 43, 150, 12, ES_AUTOHSCROLL
    LTEXT           "&Look in:", -1, 14, 62, 54, 8
    COMBOBOX        IDC_FIND_LOOKIN, 70, 60, 150, 80, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Include &subfolders", IDC_FIND_SUBFOLDERS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 70, 79, 100, 10
    DEFPUSHBUTTON   "F&ind Now", IDC_FIND_FIND, 236, 8, 58, 14
    PUSHBUTTON      "Sto&p", IDC_FIND_STOP, 236, 26, 58, 14
    PUSHBUTTON      "Ne&w Search", IDC_FIND_NEW, 236, 44, 58, 14
END

